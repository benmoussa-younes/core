<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Core.UI.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core.UI/Core.UI.csproj" />
    <ProjectReference Include="../../src/Core.Platform/Core.Platform.csproj" />
    <ProjectReference Include="../../src/Core.Platform.Linux/Core.Platform.Linux.csproj" />
    <!-- The probe is a separate process; it is copied with its runtimeconfig so the
         test can start it with `dotnet <out>/crash-probe/Core.UI.CrashProbe.dll`. -->
    <ProjectReference Include="../Core.UI.CrashProbe/Core.UI.CrashProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Core.IO/Core.IO.csproj" />
    <ProjectReference Include="../../src/Core.Serialization/Core.Serialization.csproj" />
  </ItemGroup>
  <Target Name="CopyCrashProbe" AfterTargets="Build">
    <ItemGroup>
      <CrashProbeFiles Include="$(MSBuildThisFileDirectory)../Core.UI.CrashProbe/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(CrashProbeFiles)" DestinationFiles="@(CrashProbeFiles->'$(OutDir)crash-probe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
