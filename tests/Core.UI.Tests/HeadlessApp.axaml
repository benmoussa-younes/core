<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Core.UI.Tests.HeadlessApp">
    <!--
        The headless tests run against the real theme, exactly as the application
        does, so a control's layout, hit-testing and brushes are what the operator
        sees and clicks, not an unstyled default.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Core.UI/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://Core.UI/Themes/Icons.axaml" />
                <ResourceInclude Source="avares://Core.UI/Themes/Accents.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <StyleInclude Source="avares://Core.UI/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
