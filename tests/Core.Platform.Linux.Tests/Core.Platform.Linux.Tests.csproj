<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Core.Platform.Linux.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core.Platform.Linux/Core.Platform.Linux.csproj" />
    <ProjectReference Include="../../src/Core.IO/Core.IO.csproj" />
    <ProjectReference Include="../Core.Unix.Probe/Core.Unix.Probe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyUnixProbe" AfterTargets="Build">
    <PropertyGroup>
      <UnixProbeDirectory Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildThisFileDirectory)../Core.Unix.Probe/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)</UnixProbeDirectory>
      <UnixProbeDirectory Condition="'$(RuntimeIdentifier)' == ''">$(MSBuildThisFileDirectory)../Core.Unix.Probe/bin/$(Configuration)/$(TargetFramework)</UnixProbeDirectory>
    </PropertyGroup>
    <ItemGroup>
      <UnixProbeFiles Include="$(UnixProbeDirectory)/Core*.dll" />
      <UnixProbeFiles Include="$(UnixProbeDirectory)/Core.Unix.Probe.deps.json" />
      <UnixProbeFiles Include="$(UnixProbeDirectory)/Core.Unix.Probe.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(UnixProbeFiles)" DestinationFiles="@(UnixProbeFiles->'$(OutDir)unix-probe/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
