<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Release identity. Core is consumed by ProjectReference, so no package is
       produced; the version and the licensing identity stay on the assemblies. -->
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.4.0</VersionPrefix>
    <!-- The gate reads this back: it proves the props declared the version, not the SDK default. -->
    <CoreVersionPrefixDeclared>$(VersionPrefix)</CoreVersionPrefixDeclared>
    <Authors>Younes BENMOUSSA</Authors>
    <Company>Younes BENMOUSSA</Company>
    <Product>Core</Product>
    <Copyright>Copyright (C) 2026 Younes BENMOUSSA &lt;younes.benmoussa@pm.me&gt;</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SPDX-License-Identifier" Value="LGPL-3.0-or-later" />
  </ItemGroup>
</Project>
