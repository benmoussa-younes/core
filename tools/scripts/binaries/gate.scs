#!/usr/bin/env -S scripts run
# SPDX-FileCopyrightText: 2026 Younes BENMOUSSA <younes.benmoussa@pm.me>
# SPDX-License-Identifier: LGPL-3.0-or-later
import "../modules/verdict.scs" as verdict
import "../modules/repo.scs" as repo
# gate — read-only verification of the Core repository.
#
#   tools/scripts/binaries/gate.scs [--aot]
# It checks the published tree (no docs, the markdown allowlist, one root
# AGENTS.md, short nested AGENTS.md allowed, no agent or editor files, no
# internal host or personal path, the
# version, an empty PublicAPI.Shipped, the LGPL files, the comment form and the
# SPDX header), runs the
# linter's own checks, then the build, the tests (one TRX per test project under
# the ignored TestResults/, a check that the list covers every test project, that
# each TRX holds at least one result, and that TestResults was cleared) and
# `reuse lint`. A failed build stops the test step, so no green test result can
# come from stale binaries. It writes nothing tracked and needs the Scripts
# interpreter on PATH.

function read_text(base: string, relative: string) -> string {
    match filesystem.read_file("{base}/{relative}".to_path()) {
        ok(content) => {
            return content
        }
        error(_) => {
            return ""
        }
    }
}

function report(name: string, passed: boolean, detail: string) -> boolean {
    if passed {
        io.write_standard_output_line("PASS {name}")
    } else {
        io.write_standard_error_line("FAIL {name}: {detail}")
    }
    return passed
}

# F20: the manual/nightly AOT mode publishes the Unix probe for linux-x64 and
# runs its `--self-test`, so a native publish proves the AOT and trim surface.
# It needs only the SDK; the fast gate does not publish.

let root: path = repo.root_path_from(process.script_path())
let base: string = root.to_string()
let mutable success = true
let mutable aot_mode = false
# WHY: an ignored argument let a typo or a mode that does not exist run the fast
# gate under a green verdict, so an unknown argument stops before any check.
let mutable unknown_arguments: list<string> = []
for argument in process.arguments() {
    if argument == "--aot" {
        aot_mode = true
    } else {
        unknown_arguments.append(argument)
    }
}
if unknown_arguments.length() > 0 {
    let unknown_detail = unknown_arguments.join(", ")
    io.write_standard_error_line("FAIL arguments: {unknown_arguments.length()} unknown [{unknown_detail}]")
    io.write_standard_error_line("usage: gate.scs [--aot]")
    io.write_standard_output_line(verdict.line(false))
    process.exit_with_code(verdict.code(false))
}

let mutable files: list<string> = []
match process.run(process.request("git", ["ls-files", "--cached", "--others", "--exclude-standard"]).with_working_directory(root)) {
    ok(completed) => {
        if completed.exit_code == 0 {
            files = completed.standard_output.lines()
        } else {
            io.write_standard_error_line("FAIL file list: git exit {completed.exit_code} {completed.standard_error.trim_whitespace()}")
            success = false
        }
    }
    error(failure) => {
        io.write_standard_error_line("FAIL file list: {failure.kind}")
        success = false
    }
}

let mutable docs_files: list<string> = []
let mutable markdown: list<string> = []
let mutable nested_agents: list<string> = []
let mutable agent_entries: list<string> = []
let mutable root_agents = 0
for entry in files {
    let name = entry.trim_whitespace()
    if name != "" {
        if name.starts_with("docs/") {
            docs_files.append(name)
        }
        if name.ends_with(".md") {
            markdown.append(name)
        }
        if name == "AGENTS.md" {
            root_agents = root_agents + 1
        }
        if name.ends_with("/AGENTS.md") {
            nested_agents.append(name)
        }
        if name.starts_with(".opencode/") or name == "opencode.json" or name.starts_with(".vscode/") or name.starts_with(".agents/") {
            agent_entries.append(name)
        }
    }
}

let mutable unexpected_markdown: list<string> = []
for name in markdown {
    if name != "README.md" and name != "AGENTS.md" and name != "CHANGELOG.md" and name != "SECURITY.md" and name != "CONTRIBUTING.md" and not name.ends_with("/AGENTS.md") {
        unexpected_markdown.append(name)
    }
}

if not report("no docs tracked", docs_files.length() == 0, docs_files.join(", ")) {
    success = false
}
if not report("markdown allowlist", unexpected_markdown.length() == 0, unexpected_markdown.join(", ")) {
    success = false
}
if not report("one root AGENTS.md", root_agents == 1, "{root_agents} found") {
    success = false
}
if not report("nested AGENTS.md", true, nested_agents.join(", ")) {
    success = false
}
if not report("no agent or editor files", agent_entries.length() == 0, agent_entries.join(", ")) {
    success = false
}

let mutable version = ""
match process.run(process.request("dotnet", ["msbuild", "src/Core/Core.csproj", "-getProperty:VersionPrefix", "-nologo"]).with_working_directory(root)) {
    ok(completed) => {
        if completed.exit_code == 0 {
            version = completed.standard_output.trim_whitespace()
        } else {
            io.write_standard_error_line("FAIL version: msbuild exit {completed.exit_code} {completed.standard_error.trim_whitespace()}")
            success = false
        }
    }
    error(failure) => {
        io.write_standard_error_line("FAIL version: {failure.kind}")
        success = false
    }
}
let mutable declared = ""
match process.run(process.request("dotnet", ["msbuild", "src/Core/Core.csproj", "-getProperty:CoreVersionPrefixDeclared", "-nologo"]).with_working_directory(root)) {
    ok(completed) => {
        if completed.exit_code == 0 {
            declared = completed.standard_output.trim_whitespace()
        } else {
            io.write_standard_error_line("FAIL version: msbuild exit {completed.exit_code} {completed.standard_error.trim_whitespace()}")
            success = false
        }
    }
    error(failure) => {
        io.write_standard_error_line("FAIL version: {failure.kind}")
        success = false
    }
}
if not report("version {version}", version != "" and version == declared, "Directory.Build.props") {
    success = false
}

let projects: list<string> = ["Core", "Core.Platform", "Core.Platform.Linux", "Core.UI", "Core.Concurrency", "Core.IO", "Core.Mvp", "Core.Serialization"]
let mutable shipped_defects: list<string> = []
for project in projects {
    let content = read_text(base, "src/{project}/PublicAPI.Shipped.txt")
    if content.trim_whitespace() != "#nullable enable" {
        shipped_defects.append(project)
    }
}
if not report("empty PublicAPI.Shipped", shipped_defects.length() == 0, shipped_defects.join(", ")) {
    success = false
}

# F19: the portable layers must not call a platform API directly; the adapters
# live in Core.Platform.Linux. A mutation that adds LibraryImport/DllImport,
# UnixFileMode or an OperatingSystem.Is* branch to one of these projects turns
# this check red, except the one probe src/AGENTS.md names.
let portable_projects: list<string> = ["Core", "Core.IO", "Core.Serialization", "Core.Mvp", "Core.Concurrency", "Core.Platform"]
let topology_probe = "src/Core.Concurrency/Platform.Linux/ProcessorTopology.cs"
let mutable portable_leaks: list<string> = []
for project in portable_projects {
    match process.run(process.request("grep", ["-rInE", "LibraryImport|DllImport|UnixFileMode|OperatingSystem[.]Is", "src/{project}", "--include=*.cs"]).with_working_directory(root)) {
        ok(completed) => {
            if completed.exit_code == 0 {
                let mutable leaks: list<string> = []
                for line in completed.standard_output.lines() {
                    # WHY: the grep line is path:line:content; the exemption holds
                    # only when the path is the probe and the next field is a line
                    # number, so a path that merely starts with the probe stays a leak.
                    let parts = line.split(":")
                    let mutable sanctioned = false
                    if parts.length() >= 3 and parts[0] == topology_probe {
                        let line_number = parts[1]
                        match line_number.parse_integer() {
                            ok(_) => {
                                sanctioned = true
                            }
                            error(_) => {}
                        }
                    }
                    if not sanctioned {
                        leaks.append(line)
                    }
                }
                if leaks.length() > 0 {
                    let leak_detail = leaks.join(" | ")
                    portable_leaks.append("{project}: {leak_detail}")
                }
            } else if completed.exit_code != 1 {
                io.write_standard_error_line("FAIL portable layers have no Linux API: grep exit {completed.exit_code} in {project}")
                success = false
            }
        }
        error(failure) => {
            io.write_standard_error_line("FAIL portable layers have no Linux API: {failure.kind}")
            success = false
        }
    }
}
if not report("portable layers have no Linux API", portable_leaks.length() == 0, portable_leaks.join(" | ")) {
    success = false
}

let third_party = read_text(base, "THIRD-PARTY")
let mutable licence_gaps: list<string> = []
for entry in files {
    let project = entry.trim_whitespace()
    if not project.ends_with(".csproj") {
        continue
    }
    match process.run(process.request("dotnet", ["msbuild", project, "-getItem:PackageReference", "-nologo"]).with_working_directory(root)) {
        ok(completed) => {
            if completed.exit_code != 0 {
                io.write_standard_error_line("FAIL THIRD-PARTY names every evaluated package: msbuild exit {completed.exit_code} on {project}")
                success = false
            } else {
                for line in completed.standard_output.lines() {
                    if line.contains("\"Identity\"") {
                        let parts = line.split("\"")
                        if parts.length() >= 4 and not third_party.contains(parts[3]) {
                            licence_gaps.append("{parts[3]} ({project})")
                        }
                    }
                }
            }
        }
        error(failure) => {
            io.write_standard_error_line("FAIL THIRD-PARTY names every evaluated package: {failure.kind}")
            success = false
        }
    }
}
if not report("THIRD-PARTY mentions every evaluated package", licence_gaps.length() == 0, licence_gaps.join(", ")) {
    success = false
}

let licence = read_text(base, "LICENSE")
let lgpl = read_text(base, "LICENSES/LGPL-3.0-or-later.txt")
let licence_ok = licence.contains("GNU Lesser General Public License") and lgpl.contains("GNU LESSER GENERAL PUBLIC LICENSE")
if not report("LGPL-3.0-or-later", licence_ok, "LICENSE or LICENSES/LGPL-3.0-or-later.txt") {
    success = false
}

# The fragments keep the gate's own source out of the match.
let host = "bit-crafts"
let domain = ".com"
let workspace_root = "/srv/"
let workspace_leaf = "workspace"
let user_name = "younes"
let user_leaf = "-benmoussa"
let forbidden = "{host}{domain}|{workspace_root}{workspace_leaf}|/home/{user_name}{user_leaf}"
match process.run(process.request("grep", ["-rInE", "--exclude-dir=.git", "--exclude-dir=bin", "--exclude-dir=obj", "--exclude-dir=artifacts", "--exclude-dir=docs", "--exclude-dir=TestResults", forbidden, "."]).with_working_directory(root)) {
    ok(completed) => {
        if completed.exit_code == 1 {
            io.write_standard_output_line("PASS no internal host or personal path")
        } else if completed.exit_code == 0 {
            io.write_standard_error_line("FAIL no internal host or personal path: {completed.standard_output.trim_whitespace()}")
            success = false
        } else {
            io.write_standard_error_line("FAIL no internal host or personal path: grep exit {completed.exit_code}")
            success = false
        }
    }
    error(failure) => {
        io.write_standard_error_line("FAIL no internal host or personal path: {failure.kind}")
        success = false
    }
}

match process.run(process.request("tools/scripts/binaries/lint-comments", []).with_working_directory(root)) {
    ok(completed) => {
        if completed.exit_code == 0 {
            io.write_standard_output_line("PASS comment form and SPDX header")
        } else {
            for line in completed.standard_output.lines() {
                if line != "" {
                    io.write_standard_error_line(line)
                }
            }
            for line in completed.standard_error.lines() {
                if line != "" {
                    io.write_standard_error_line(line)
                }
            }
            io.write_standard_error_line("FAIL comment form and SPDX header")
            success = false
        }
    }
    error(failure) => {
        io.write_standard_error_line("FAIL comment form and SPDX header: {failure.kind}")
        success = false
    }
}

match process.run(process.request("tools/scripts/binaries/test-lint-comments", []).with_working_directory(root)) {
    ok(completed) => {
        if completed.exit_code == 0 {
            io.write_standard_output_line("PASS comment checks")
        } else {
            for line in completed.standard_output.lines() {
                if line != "" {
                    io.write_standard_error_line(line)
                }
            }
            for line in completed.standard_error.lines() {
                if line != "" {
                    io.write_standard_error_line(line)
                }
            }
            io.write_standard_error_line("FAIL comment checks")
            success = false
        }
    }
    error(failure) => {
        io.write_standard_error_line("FAIL comment checks: {failure.kind}")
        success = false
    }
}

let mutable build_ok = false
match process.run(process.request("dotnet", ["build", "-c", "Release"]).with_working_directory(root)) {
    ok(completed) => {
        if completed.exit_code == 0 {
            io.write_standard_output_line("PASS build")
            build_ok = true
        } else {
            for line in completed.standard_output.lines() {
                let lower = line.lowercased()
                if lower.contains("error") or lower.contains("erreur") {
                    io.write_standard_error_line(line)
                }
            }
            io.write_standard_error_line("FAIL build: exit {completed.exit_code} {completed.standard_error.trim_whitespace()}")
            success = false
        }
    }
    error(failure) => {
        io.write_standard_error_line("FAIL build: {failure.kind}")
        success = false
    }
}

# F21: every test project keeps its own TRX, so the evidence names each project
# instead of the last writer. The list is the test projects of Core.slnx: the
# probes carry no test SDK, and the GUI integration suite is left to its own run
# (its cases are skipped unless CORE_GUI_TESTS=1).
let test_projects: list<string> = ["Core.Tests", "Core.Concurrency.Tests", "Core.IO.Tests", "Core.Mvp.Tests", "Core.Pipeline.Tests", "Core.Platform.Linux.Tests", "Core.Records.Tests", "Core.Serialization.Tests", "Core.UI.Tests"]

# WHY: a test project in tests/ that carries the test SDK but is absent from the
# list is built and never run, so the list is checked against the tree; the GUI
# integration suite is the one named exception (its own Xvfb run owns it).
let mutable unlisted_tests: list<string> = []
for entry in files {
    let candidate = entry.trim_whitespace()
    if not candidate.starts_with("tests/") or not candidate.ends_with(".csproj") {
        continue
    }
    if not read_text(base, candidate).contains("Microsoft.NET.Test.Sdk") {
        continue
    }
    let parts = candidate.split("/")
    if parts.length() >= 3 {
        let name = parts[1]
        if name != "Core.UI.IntegrationTests" and not test_projects.contains(name) {
            unlisted_tests.append(name)
        }
    }
}
let unlisted_detail = unlisted_tests.join(", ")
if not report("test project list is complete", test_projects.length() > 0 and unlisted_tests.length() == 0, "unlisted test projects: {unlisted_detail}") {
    success = false
}

# WHY: a TRX left by a previous run would satisfy the evidence check after a
# project stopped running, so every gate run starts from an empty TestResults,
# whether or not the build passes.
let mutable results_ready = true
if filesystem.path_exists(root / "TestResults") {
    match filesystem.remove_directory_tree(root / "TestResults") {
        ok(_) => {}
        error(_) => {
            io.write_standard_error_line("FAIL test evidence: cannot clear TestResults")
            success = false
            results_ready = false
        }
    }
}

if not build_ok {
    io.write_standard_error_line("FAIL tests: the build did not succeed")
    success = false
} else {
    let mutable tests_ok = true
    for project in test_projects {
        match process.run(process.request("dotnet", ["test", "tests/{project}/{project}.csproj", "-c", "Release", "--no-build", "--logger", "trx;LogFileName={project}.trx", "--results-directory", "TestResults/{project}"]).with_working_directory(root)) {
            ok(completed) => {
                if completed.exit_code != 0 {
                    let failure_lines = completed.standard_output.lines()
                    let mutable failure_start = failure_lines.length() - 80
                    if failure_start < 0 {
                        failure_start = 0
                    }
                    while failure_start < failure_lines.length() {
                        if failure_lines[failure_start] != "" {
                            io.write_standard_error_line(failure_lines[failure_start])
                        }
                        failure_start = failure_start + 1
                    }
                    io.write_standard_error_line("FAIL tests {project}: exit {completed.exit_code} {completed.standard_error.trim_whitespace()}")
                    success = false
                    tests_ok = false
                }
            }
            error(failure) => {
                io.write_standard_error_line("FAIL tests {project}: {failure.kind}")
                success = false
                tests_ok = false
            }
        }
    }
    if tests_ok {
        io.write_standard_output_line("PASS tests")
    }
}

if not results_ready {
    io.write_standard_error_line("FAIL test evidence: the results were not cleared, so they are not trusted")
} else {
    # WHY: a single shared TRX name let the last test project overwrite the
    # others, so the evidence held one project's count and the survivor was
    # arbitrary.
    let mutable missing_trx: list<string> = []
    for project in test_projects {
        if read_text(base, "TestResults/{project}/{project}.trx") == "" {
            missing_trx.append(project)
        }
    }
    let trx_detail = missing_trx.join(", ")
    if not report("test evidence", missing_trx.length() == 0, "no TRX for {trx_detail}") {
        success = false
    }

    # WHY: a well-formed TRX with zero results proves a file, not a test run, so
    # each project must also carry at least one result line.
    let mutable empty_trx: list<string> = []
    for project in test_projects {
        let trx = "TestResults/{project}/{project}.trx"
        let mutable results = 0
        match process.run(process.request("grep", ["-c", "<UnitTestResult ", trx]).with_working_directory(root)) {
            ok(completed) => {
                let count_text = completed.standard_output.trim_whitespace()
                match count_text.parse_integer() {
                    ok(value) => {
                        results = value
                    }
                    error(_) => {}
                }
            }
            error(_) => {}
        }
        if results <= 0 {
            empty_trx.append(project)
        }
    }
    let empty_detail = empty_trx.join(", ")
    if not report("test evidence has results", empty_trx.length() == 0, "no result in {empty_detail}") {
        success = false
    }
}

match process.run(process.request("reuse", ["lint"]).with_working_directory(root)) {
    ok(completed) => {
        if completed.exit_code == 0 {
            io.write_standard_output_line("PASS reuse lint")
        } else {
            io.write_standard_error_line("FAIL reuse lint: exit {completed.exit_code} {completed.standard_error.trim_whitespace()}")
            success = false
        }
    }
    error(failure) => {
        io.write_standard_error_line("FAIL reuse lint: {failure.kind}")
        success = false
    }
}

if aot_mode {
    let mutable unix_probe_ready = false
    match process.run(process.request("dotnet", ["publish", "tests/Core.Unix.Probe/Core.Unix.Probe.csproj", "-c", "Release", "-r", "linux-x64", "-o", "/tmp/core-gate-unix"]).with_working_directory(root)) {
        ok(completed) => {
            # WHY: csharp-style requires the gate to count AOT diagnostics even though the publish fails them.
            let mutable ilc_lines = 0
            for line in completed.standard_output.lines() {
                if line.contains("ILC:") or line.contains("ILC :") or line.contains("warning IL") {
                    ilc_lines = ilc_lines + 1
                }
            }
            for line in completed.standard_error.lines() {
                if line.contains("ILC:") or line.contains("ILC :") or line.contains("warning IL") {
                    ilc_lines = ilc_lines + 1
                }
            }
            if completed.exit_code != 0 {
                io.write_standard_error_line("FAIL unix probe publish: exit {completed.exit_code} {completed.standard_error.trim_whitespace()}")
                success = false
            } else if ilc_lines > 0 {
                io.write_standard_error_line("FAIL unix probe publish: {ilc_lines} ILC lines")
                success = false
            } else {
                io.write_standard_output_line("PASS unix probe publish")
                unix_probe_ready = true
            }
        }
        error(failure) => {
            io.write_standard_error_line("FAIL unix probe publish: {failure.kind}")
            success = false
        }
    }

    if unix_probe_ready {
        match process.run(process.request("/tmp/core-gate-unix/Core.Unix.Probe", ["--self-test"])) {
            ok(completed) => {
                if completed.exit_code == 0 {
                    io.write_standard_output_line("PASS unix probe self-test")
                } else {
                    io.write_standard_error_line("FAIL unix probe self-test: exit {completed.exit_code} {completed.standard_output.trim_whitespace()} {completed.standard_error.trim_whitespace()}")
                    success = false
                }
            }
            error(failure) => {
                io.write_standard_error_line("FAIL unix probe self-test: {failure.kind}")
                success = false
            }
        }
    }
}

io.write_standard_output_line(verdict.line(success))
process.exit_with_code(verdict.code(success))
