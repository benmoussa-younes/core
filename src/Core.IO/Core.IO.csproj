<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Core.IO</RootNamespace>
    <Description>Portable IO algorithms for the Core toolchain: descriptor-pinned directory walk, file metadata, safe reads, memory mapping, record scan/index and the generic block pipeline. No Linux API leaks into this assembly; NativeAOT and trim-safe.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Platform/Core.Platform.csproj" />
    <ProjectReference Include="../Core/Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Core.IO.Tests" />
    <InternalsVisibleTo Include="Core.Platform.Linux" />
    <InternalsVisibleTo Include="Core.Platform.Linux.Tests" />
    <InternalsVisibleTo Include="Core.Records.Tests" />
  </ItemGroup>
</Project>
