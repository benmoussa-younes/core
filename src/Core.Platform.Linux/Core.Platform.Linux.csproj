<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Core.Platform.Linux</RootNamespace>
    <Description>Linux adapters for Core.Platform and the UI host: XDG paths, the file system and directory reader, raw mmap, the atomic writer, owner-only diagnostics, the Unix-domain single-instance lock, the process runner, the raw walker and LinuxPlatform. Other adapters can implement the same ports on Windows or macOS.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="../Core.IO/Core.IO.csproj" />
    <ProjectReference Include="../Core.Platform/Core.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Core.IO" />
    <InternalsVisibleTo Include="Core.IO.Tests" />
    <InternalsVisibleTo Include="Core.Platform.Linux.Tests" />
  </ItemGroup>
</Project>
