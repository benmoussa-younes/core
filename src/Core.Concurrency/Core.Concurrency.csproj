<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Core.Concurrency</RootNamespace>
    <Description>General-purpose parallel library: dedicated reused worker threads with direct dispatch, index parallelism (static or claim-one), a bounded producer/consumer queue, arbitrary-task waves with an explicit barrier, per-worker slots, a per-call abort contract and a configurable worker stack. Linux, NativeAOT and trim-safe.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Core.Concurrency.Tests" />
  </ItemGroup>
</Project>
