<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Core.UI</RootNamespace>
    <Description>Shared Avalonia shell for the Core toolchain: application builder and backend selection (Win32, macOS, native Wayland, X11), CoreHost on CorePlatform, the embedded Inter font, theme/controls, dialogs, notifications and the tray. NativeAOT and trim-safe.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Wayland" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Platform/Core.Platform.csproj" />
    <ProjectReference Include="../Core.Mvp/Core.Mvp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Themes/*.axaml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Core.UI.Tests" />
  </ItemGroup>
</Project>
