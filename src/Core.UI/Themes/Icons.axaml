<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The shell's symbolic icons: 16x16 nominal, monochrome and stroked, so the
        theme recolours them and they read at 16 px. The style is the GNOME HIG
        "UI Icons" symbolic style; the shapes are ours (the HIG asks for a consistent
        set, and a bundled third-party icon theme would need its own licence and
        attribution). A product names a glyph by key in AppCommand.IconKey.
    -->
    <StreamGeometry x:Key="IconNew">M4 2 H9 L12 5 V14 H4 Z M9 2 V5 H12</StreamGeometry>
    <StreamGeometry x:Key="IconOpen">M2 4 H6 L7.5 6 H14 V12 H2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSave">M3 3 H11 L13 5 V13 H3 Z M5 3 V7 H10 V3 M5.5 10 H10.5</StreamGeometry>
    <StreamGeometry x:Key="IconSaveAs">M2.5 3 H8 V13 H2.5 Z M6 8 H13.5 M11.5 6 L13.5 8 L11.5 10</StreamGeometry>
    <StreamGeometry x:Key="IconUndo">M6 4 L3 7 L6 10 M3 7 H9 C11.2 7 13 8.8 13 11</StreamGeometry>
    <StreamGeometry x:Key="IconRedo">M10 4 L13 7 L10 10 M13 7 H7 C4.8 7 3 8.8 3 11</StreamGeometry>
    <StreamGeometry x:Key="IconRowInsert">M8 1 V5 M6 3 H10 M2 8 H14 M2 11 H14</StreamGeometry>
    <StreamGeometry x:Key="IconRowDelete">M6 3 H10 M2 8 H14 M2 11 H14</StreamGeometry>
    <StreamGeometry x:Key="IconColumnInsert">M6 2 V14 M9 2 V14 M1 8 H5 M3 6 V10</StreamGeometry>
    <StreamGeometry x:Key="IconColumnDelete">M6 2 V14 M9 2 V14 M1 8 H5</StreamGeometry>
    <StreamGeometry x:Key="IconColumns">M3 2 V14 M8 2 V14 M13 2 V14 M2 5 H14</StreamGeometry>
    <StreamGeometry x:Key="IconSortAscending">M8 13 V3 M5 6 L8 3 L11 6</StreamGeometry>
    <StreamGeometry x:Key="IconSortDescending">M8 3 V13 M5 10 L8 13 L11 10</StreamGeometry>
    <StreamGeometry x:Key="IconHideColumn">M3 8 C5 5 11 5 13 8 C11 11 5 11 3 8 Z M2 2 L14 14</StreamGeometry>
    <StreamGeometry x:Key="IconShowColumns">M3 8 C5 5 11 5 13 8 C11 11 5 11 3 8 Z M8 6 A2 2 0 1 0 8 10 A2 2 0 1 0 8 6</StreamGeometry>
    <StreamGeometry x:Key="IconFreezeColumn">M5.5 7 V5 A2.5 2.5 0 0 1 10.5 5 V7 M4 7 H12 V13 H4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconFind">M7 3 A4 4 0 1 0 7 11 A4 4 0 1 0 7 3 M10 10 L13.5 13.5</StreamGeometry>
    <StreamGeometry x:Key="IconMacro">M2.5 3.5 H13.5 V12.5 H2.5 Z M5 6.5 L7 8.5 L5 10.5 M8.5 10.5 H11</StreamGeometry>
    <StreamGeometry x:Key="IconCopy">M5 5 H12 V13 H5 Z M3 3 H10 V11 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPaste">M5 3 H11 V5 H5 Z M4 4 H12 V13 H4 Z M6 8 H10 M6 11 H10</StreamGeometry>
    <StreamGeometry x:Key="IconClear">M4 4 L11 11 M11 4 L4 11</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M8 5.5 A2.5 2.5 0 1 0 8 10.5 A2.5 2.5 0 1 0 8 5.5 M8 1.5 V3 M8 13 V14.5 M1.5 8 H3 M13 8 H14.5 M3.4 3.4 L4.5 4.5 M11.5 11.5 L12.6 12.6 M12.6 3.4 L11.5 4.5 M4.5 11.5 L3.4 12.6</StreamGeometry>
    <StreamGeometry x:Key="IconAbout">M8 2 A6 6 0 1 0 8 14 A6 6 0 1 0 8 2 M8 7 V11 M8 5 V5.5</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M4 4 L12 12 M12 4 L4 12</StreamGeometry>
    <StreamGeometry x:Key="IconSun">M8 5 A3 3 0 1 0 8 11 A3 3 0 1 0 8 5 M8 1 V3 M8 13 V15 M1 8 H3 M13 8 H15 M3.9 3.9 L5.3 5.3 M10.7 10.7 L12.1 12.1 M12.1 3.9 L10.7 5.3 M5.3 10.7 L3.9 12.1</StreamGeometry>
    <StreamGeometry x:Key="IconMoon">M12 9.5 A4.5 4.5 0 1 1 6.5 4 A3.5 3.5 0 0 0 12 9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPalette">M8 2 A6 6 0 1 0 8 14 A6 6 0 1 0 8 2 M5.5 6 A1 1 0 1 0 5.5 8 A1 1 0 1 0 5.5 6 M10.5 6 A1 1 0 1 0 10.5 8 A1 1 0 1 0 10.5 6 M8 9 A1 1 0 1 0 8 11 A1 1 0 1 0 8 9</StreamGeometry>
</ResourceDictionary>
